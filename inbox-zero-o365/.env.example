# =============================================================================
# inbox-zero-o365 — Office 365 Pipeline Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# See README.md for detailed setup instructions.

# -----------------------------------------------------------------------------
# Azure Entra ID — App Registration
# -----------------------------------------------------------------------------
# How to get these values:
#   1. Go to https://portal.azure.com/ → Entra ID → App registrations
#   2. Register a new app (single tenant, no redirect URI)
#   3. Copy the Application (client) ID and Directory (tenant) ID from Overview
#   4. Add API permissions: Mail.Read, Mail.ReadWrite, MailboxSettings.ReadWrite
#   5. Grant admin consent
#   6. Certificates & secrets → New client secret → copy the Value

# Directory (tenant) ID — from the app's Overview page
O365_TENANT_ID=

# Application (client) ID — from the app's Overview page
O365_CLIENT_ID=

# Client secret value — from Certificates & secrets (shown only once when created)
O365_CLIENT_SECRET=

# The O365 mailbox email address to process
O365_USER_EMAIL=you@yourdomain.com

# -----------------------------------------------------------------------------
# Google Sheets — Audit Report (via Service Account)
# -----------------------------------------------------------------------------
# Reuse the same GCP service account from the Gmail pipeline, or create a new one.
# How to get this:
#   1. Go to https://console.cloud.google.com/ → IAM & Admin → Service Accounts
#   2. Create a service account with Sheets API enabled
#   3. Download JSON key to .secrets/service-account.json
#   4. For Workspace: set up domain-wide delegation for the spreadsheets scope
GOOGLE_SERVICE_ACCOUNT_KEY=.secrets/service-account.json

# The email to impersonate when accessing Google Sheets (Workspace only)
GOOGLE_IMPERSONATE_USER=

# -----------------------------------------------------------------------------
# Anthropic — LLM Classification (Optional)
# -----------------------------------------------------------------------------
# API key for Claude Haiku sender classification.
# How to get this:
#   1. Go to https://console.anthropic.com/
#   2. Create account and add billing
#   3. API Keys → Create Key
#   4. Copy the key (starts with sk-ant-)
# Omit this to use heuristic-only classification.
ANTHROPIC_API_KEY=
