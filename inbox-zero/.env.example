# =============================================================================
# inbox-zero — Gmail Pipeline Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# See README.md for detailed setup instructions.

# -----------------------------------------------------------------------------
# Google Cloud Platform — Service Account
# -----------------------------------------------------------------------------
# Path to the JSON key file for your GCP service account.
# How to get this:
#   1. Go to https://console.cloud.google.com/ → IAM & Admin → Service Accounts
#   2. Create a service account (or select existing)
#   3. Keys tab → Add Key → Create new key → JSON
#   4. Save the file as .secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=.secrets/service-account.json

# The Gmail address to process.
# For Google Workspace: the service account impersonates this user via
# domain-wide delegation (configure in admin.google.com).
# For personal Gmail: use gcloud auth application-default login instead.
GMAIL_USER=you@example.com

# GCP project ID (only needed for personal Gmail OAuth flow, not service accounts)
# GOOGLE_CLOUD_PROJECT=your-project-id

# -----------------------------------------------------------------------------
# Google Sheets — Audit Report
# -----------------------------------------------------------------------------
# The spreadsheet ID for the audit report. Created automatically by the
# enrich command on first run — paste the ID here after it's created.
# The ID is the long string in the Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
AUDIT_SHEET_ID=

# -----------------------------------------------------------------------------
# Anthropic — LLM Classification (Optional)
# -----------------------------------------------------------------------------
# API key for Claude Haiku sender classification.
# How to get this:
#   1. Go to https://console.anthropic.com/
#   2. Create account and add billing
#   3. API Keys → Create Key
#   4. Copy the key (starts with sk-ant-)
# Omit this to use heuristic-only classification (works well for most senders).
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Data Directory
# -----------------------------------------------------------------------------
# Where pipeline output is stored. Override to process multiple mailboxes:
#   DATA_DIR=./data-other GMAIL_USER=other@example.com npm run cli -- pull
DATA_DIR=./data
